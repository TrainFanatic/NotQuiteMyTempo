# Copy to fletcher/.env (git-ignored) and fill in. Never commit real keys.

# Claude API key: platform.claude.com -> API keys
ANTHROPIC_API_KEY=

# ElevenLabs: Profile -> API keys. Voice id: Voices -> your designed voice -> copy ID
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional overrides (defaults in fletcher/config.py)
# HUB_URL=ws://localhost:8765
# TTS_ENGINE=v4            # v4 (Eleven v4 Turbo, tags) | flash (Flash v2.5) | none (barks only)
# TTS_STABILITY=0.35       # lower = more volatile, angrier reads
# PROFANITY=false          # keep off for judging
# CUTOFF_ANGER=0.8         # raise if he cuts off too eagerly
# GRACE_BARS=2
# STARE_S=0.5              # the silent glare between fist and first word
# ERROR_SIGN=1             # -1 if the referee sends positive error_ms for EARLY hits
